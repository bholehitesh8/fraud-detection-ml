# Application Configuration Environment Variables
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=super-secret-fraud-detection-key-change-in-production
DATABASE_URL=sqlite:///fraud_detection.db
PORT=5000
DEBUG=True

# Google OAuth 2.0 / OpenID Connect
# Obtain these credentials from Google Cloud Console (APIs & Services > Credentials)
# Authorized Redirect URI must match: http://127.0.0.1:5000/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional redirect URI override (defaults dynamically to /auth/google/callback)
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback

